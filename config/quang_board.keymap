/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <

/* Row 0 */
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC

/* Row 1 */
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLASH

/* Row 2 (thiếu 1 slot) */
&kp CAPS &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp NONE &kp ENTER

/* Row 3 (gắn Bluetooth ở cuối) */
&kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp UP &bt BT_NXT

/* Row 4 (nhiều slot trống) */
&kp LCTRL &kp LGUI &kp LALT &kp SPACE &kp NONE &kp NONE &kp NONE &kp NONE &kp LEFT &kp DOWN &kp RIGHT &kp NONE

            >;
        };
    };
};
